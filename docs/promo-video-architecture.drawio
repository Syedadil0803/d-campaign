<mxfile host="app.diagrams.net"><diagram id="promo-video" name="Promo video"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1320" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Promo card video — how it works" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="700" height="30" as="geometry"/></mxCell><mxCell id="c3" value="1 · Adding the video — the user (the business) in Campaign Admin" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="800" height="24" as="geometry"/></mxCell><mxCell id="c4" value="Left: what happens on the user's screen · Right: the system it talks to · every request gets a reply" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="92" width="800" height="20" as="geometry"/></mxCell><mxCell id="c5" value="1 · User selects a video" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="300" height="56" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;User's device&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#666666'&gt;files on phone or laptop&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="130" width="320" height="60" as="geometry"/></mxCell><mxCell id="c7" value="open file picker" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;fontColor=#666666;labelBackgro